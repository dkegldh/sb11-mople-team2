{
  "family": "mople-nginx-lb",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::291883201761:role/ecsTaskExecutionRole",
  "volumes": [
    {
      "name": "letsencrypt",
      "host": {
        "sourcePath": "/etc/letsencrypt"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "291883201761.dkr.ecr.ap-northeast-2.amazonaws.com/mople-nginx-lb:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        },
        {
          "containerPort": 443,
          "hostPort": 443,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "letsencrypt",
          "containerPath": "/etc/letsencrypt",
          "readOnly": true
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q --spider http://localhost:80/nginx-health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mople-nginx-lb",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "nginx"
        }
      }
    }
  ]
}
